{
  "name": "@tessera/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared ESLint, Prettier, TypeScript, and Tailwind presets for Tessera.",
  "license": "MIT",
  "exports": {
    "./eslint": "./eslint/base.mjs",
