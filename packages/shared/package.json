{
  "name": "@tessera/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TS types, viem Address helpers, Zod schemas, ABIs, and the address-book loader.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./address-book": {
      "types": "./dist/address-book.d.ts",
      "default": "./dist/address-book.js"
    },
    "./seed-manifest": {
      "types": "./dist/seed-manifest.d.ts",
      "default": "./dist/seed-manifest.js"
    },
    "./abis": {
      "types": "./dist/abis/index.d.ts",
      "default": "./dist/abis/index.js"
    }
  },
  "files": ["dist", "addresses.amoy.json"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tessera/config": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3"
  }
}
