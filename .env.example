# ============================================================================
# Tessera environment — copy to `.env` and adjust. Placeholders only.
# The repo clones-and-runs with zero paid accounts: mock providers are the default,
# and the keys below are the well-known public Anvil dev keys (DEMO ONLY — never real).
# NEVER commit a real private key or API key. `.env` is gitignored.
# ============================================================================

# --- Chain of record ---------------------------------------------------------
# local = Anvil (31337) by default; amoy = Polygon Amoy (80002) for the showcase.
CHAIN_ENV=local
CHAIN_ID=31337
CONFIRMATIONS=1
RPC_URL_LOCAL=http://127.0.0.1:8545
RPC_URL_AMOY=https://rpc-amoy.polygon.technology

# --- Backend signing keys (two wallets, NEVER merged) ------------------------
# CLAIM_ISSUER_PRIVATE_KEY only signs ONCHAINID claims.
# AGENT_PRIVATE_KEY only performs token/registry operations.
# Values are public Anvil test keys — safe for local dev, replace for any real network.
CLAIM_ISSUER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
AGENT_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# Used only by the deploy scripts (account #0). Distinct from the two runtime keys.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Deploy-time addresses (derived from the keys above) ---------------------
# Read by contracts/script/Deploy.s.sol (addresses only — least privilege).
# AGENT_ADDRESS is the address of AGENT_PRIVATE_KEY (Anvil account #2).
AGENT_ADDRESS=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
# The ClaimIssuer's MANAGEMENT key. For the single-broadcast manual deploy it MUST equal the
# deployer (Anvil account #0): registering the signer key calls the onlyManager addKey().
CLAIM_ISSUER_MANAGEMENT_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
# A DISTINCT signing EOA, registered as a purpose-3 CLAIM key on the ClaimIssuer. It can sign
# claims and nothing else. Address of CLAIM_ISSUER_PRIVATE_KEY (Anvil account #1).
CLAIM_ISSUER_SIGNER_ADDRESS=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://rwa:rwa@localhost:5432/rwa?schema=public

# --- KYC / AML providers (mock is the default and always works offline) -------
PROVIDER_KYC=mock
PROVIDER_AML=mock
# Real KYC (Persona) — leave blank in mock mode.
PERSONA_API_KEY=
PERSONA_WEBHOOK_SECRET=
# Real AML (self-hosted OpenSanctions / yente) — leave blank in mock mode.
YENTE_URL=

# --- API ---------------------------------------------------------------------
API_PORT=3001
# JWT + SIWE session. Single-use, domain-bound nonces; short TTL.
JWT_SECRET=dev-only-secret-change-me
SIWE_DOMAIN=localhost:3000
SIWE_SESSION_TTL=3600
# Local-only agent allowlist fallback (used only when CHAIN_ENV=local).
AGENT_ALLOWLIST=

# --- Indexer -----------------------------------------------------------------
INDEXER_POLL_MS=2000
INDEXER_BATCH_SIZE=2000

# --- Frontends (Next.js public vars) -----------------------------------------
NEXT_PUBLIC_CHAIN_ENV=local
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_API_URL=http://localhost:3001
# WalletConnect Cloud project id for RainbowKit (optional for local dev).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Deploy / verification ---------------------------------------------------
POLYGONSCAN_API_KEY=

# --- Anvil (local chain) -----------------------------------------------------
ANVIL_MNEMONIC="test test test test test test test test test test test junk"
